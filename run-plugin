#!/usr/bin/env python3
"""Run a single cloxsom plugin in isolation, outside the full genblog pipeline."""

import argparse
import logging
import sys

from cloxsom.db import DB
from cloxsom import logconfig

from cloxsom.plugins.scanfiles import ScanFilesPlugin
from cloxsom.plugins.readfiles import ReadFilesPlugin
from cloxsom.plugins.notyet import NotYetPlugin
from cloxsom.plugins.process_meta import ProcessMetaPlugin
from cloxsom.plugins.compute_dates import ComputeDatesPlugin
from cloxsom.plugins.build_article_pages import BuildArticlePagesPlugin
from cloxsom.plugins.build_date_archives import BuildDateArchivesPlugin
from cloxsom.plugins.build_topic_archives import BuildTopicArchivesPlugin
from cloxsom.plugins.build_main_page import BuildMainPagePlugin
from cloxsom.plugins.write_html import WriteHtmlPlugin

PLUGINS = {
    cls.name(): cls
    for cls in [
        ScanFilesPlugin,
        ReadFilesPlugin,
        NotYetPlugin,
        ProcessMetaPlugin,
        ComputeDatesPlugin,
        BuildArticlePagesPlugin,
        BuildDateArchivesPlugin,
        BuildTopicArchivesPlugin,
        BuildMainPagePlugin,
        WriteHtmlPlugin,
    ]
}


def main():
    parser = argparse.ArgumentParser(description="Run a single cloxsom plugin in isolation")
    parser.add_argument('plugin', choices=sorted(PLUGINS), help='Plugin to run')
    parser.add_argument('args', nargs='*',
                        help='Arguments for the plugin (currently ignored)')
    parser.add_argument('--db', default='cloxsom.db',
                        help='Database file (default: cloxsom.db)')
    parser.add_argument('--input', default='articles',
                        help='Input directory (default: articles)')
    parser.add_argument('--verbose', '-v', action='store_true',
                        help='Verbose logging')

    parsed = parser.parse_args()

    logconfig.configure(level=logging.DEBUG if parsed.verbose else logging.WARNING)

    db = DB(parsed.db)
    config = {'input_dir': parsed.input}

    plugin_class = PLUGINS[parsed.plugin]
    plugin = plugin_class(db, config)
    result = plugin.run()
    print(result, file=sys.stderr)

    return 0


if __name__ == '__main__':
    sys.exit(main())
